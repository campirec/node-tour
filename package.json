{
  "name": "node-tour",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js 22+ / ESM / TypeScript 学习与实战工作区",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "test": "pnpm --filter @node-tour/learn-node test:solutions && pnpm --filter @node-tour/web-service test && pnpm --filter @node-tour/ai-agent test",
    "test:exercises": "pnpm --filter @node-tour/learn-node test",
    "test:solutions": "pnpm --filter @node-tour/learn-node test:solutions",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "learn": "pnpm --filter @node-tour/learn-node test",
    "learn:watch": "pnpm --filter @node-tour/learn-node test:watch",
    "dev:web": "pnpm --filter @node-tour/web-service dev",
    "dev:agent": "pnpm --filter @node-tour/ai-agent dev",
    "check": "pnpm typecheck && pnpm test"
  },
  "keywords": [
    "nodejs",
    "esm",
    "typescript",
    "pnpm-workspace",
    "nestjs",
    "ai-agent"
  ],
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
